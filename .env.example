# Copy to .env.local for local dev; add the same keys in Vercel → Settings → Environment Variables.
# Every key is optional: without them the site runs in demo mode.

# Public site URL (used for QR codes). e.g. https://stone-weirs-commons.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- AI (optional; without it the deterministic demo engine is used) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Supabase (step 2 in SETUP.md) — single production project ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (step 3) — audio / photo uploads ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stone-weirs-media

