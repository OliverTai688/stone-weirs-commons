# Copy to .env.local for local dev; add the same keys in Vercel → Settings → Environment Variables.
# Every key is optional: without them the site runs in demo mode.

# Public site URL (used for QR codes). e.g. https://stone-weirs-commons.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Required for "bring your own AI key": encrypts users' keys at rest. ---
# Generate once:  openssl rand -base64 48   (changing it later invalidates saved keys)
APP_ENCRYPTION_KEY=

# --- Optional platform AI key (used only when a user has not added their own) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Supabase (step 2 in SETUP.md) — single production project ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (step 3) — audio / photo uploads ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stone-weirs-media


# --- Welcome email (sent by the site on sign-up and on FormHug webhook) ---
# Option A (recommended now): Gmail with an App password — no custom domain needed.
GMAIL_USER=taioliver688@gmail.com
GMAIL_APP_PASSWORD=
# Option B (later, with your own domain): Resend
RESEND_API_KEY=
EMAIL_FROM=
# Optional
EMAIL_FROM_NAME=Stone Weirs, Shared Futures
EMAIL_REPLY_TO=taioliver688@gmail.com
EMAIL_HOURLY_CAP=60
# FormHug webhook: form token, and an optional shared key appended as ?key=... to the webhook URL
FORMHUG_FORM_TOKEN=SMbOkH
FORMHUG_WEBHOOK_SECRET=
