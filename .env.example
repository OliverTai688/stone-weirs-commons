# Copy to .env.local for local dev; add the same keys in Vercel → Settings → Environment Variables.
# Every key is optional: without them the site runs in demo mode.

# Public site URL (used for QR codes). e.g. https://stone-weirs-commons.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Required for "bring your own AI key": encrypts users' keys at rest. ---
# Generate once:  openssl rand -base64 48   (changing it later invalidates saved keys)
APP_ENCRYPTION_KEY=

# --- Optional platform AI key (used only when a user has not added their own) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Supabase (step 2 in SETUP.md) — single production project ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (step 3) — audio / photo uploads ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stone-weirs-media

